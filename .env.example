# ============================================================
# IDS Research Pipeline System — Environment Variables
# Copy this file to .env and fill in values for local dev.
# Docker Compose sets these automatically via its environment: block.
# ============================================================

# --- Execution Mode ---
# Set to "true" to use Celery + Redis async execution.
# Set to "false" (default) for synchronous local execution.
USE_ASYNC=false

# --- Database ---
# Path to SQLite database file.
# Default: storage/experiments.db (relative to project root)
# DB_PATH=storage/experiments.db

# --- Celery (only needed when USE_ASYNC=true) ---
# Redis broker URL
# CELERY_BROKER_URL=redis://localhost:6379/0

# Redis result backend URL
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Berapa eksperimen boleh berjalan BERSAMAAN. Bawaan 1: satu per satu.
#
# Menaikkannya mengubah TIGA hal sekaligus, dan ketiganya membaca variabel ini
# supaya tidak dapat menyimpang: `--concurrency` container worker, pool-nya
# (compose memakai `prefork`, sebab `--pool=solo` tidak pernah paralel), dan
# jatah RAM per run yang dipakai UI untuk mengunci dataset terlalu besar.
#
# Aturan ukurannya: WORKER_MEM_LIMIT_MB dibagi angka ini harus tetap nyaman di
# atas 3,7 GB, yaitu puncak RAM pipeline terberat (EVE cbr). Contoh server
# dengan WORKER_MEM_LIMIT_MB=32000: concurrency 4 memberi 8000 MB per run.
# CELERY_CONCURRENCY=1
#
# Jalan keluar bila `prefork` bermasalah di suatu host (mis. menjalankan worker
# langsung di Windows, bukan di container). `solo` memaksa satu per satu
# berapa pun CELERY_CONCURRENCY-nya.
# CELERY_POOL=prefork

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Set to "true" for JSON-formatted logs (recommended in Docker)
# JSON_LOGS=false

# --- Docker (set automatically by docker-compose.yml) ---
# Docker image version tag (captured in experiment metadata for reproducibility)
# DOCKER_IMAGE_VERSION=1.0.0

# --- Storage (optional overrides) ---
# Override default storage paths if needed.
# STORAGE_PATH=/custom/path/to/storage

# --- Pagu RAM worker ---
# Satu variabel ini mengatur DUA hal sekaligus: `mem_limit` container worker
# dan pagu yang dipakai UI untuk mengunci dataset yang pasti tidak muat.
# Bawaan 3500 MB adalah pagu mesin pengembangan (Docker Desktop di WSL2).
# Di server, naikkan: RAM total dari `free -h` dikurangi sekitar 2 GB untuk
# sistem operasi, UI, dan Redis. Contoh server 16 GB: 13000.
WORKER_MEM_LIMIT_MB=3500

# --- Akses menjalankan eksperimen ---
# Bawaan: siapa pun, termasuk pengunjung tanpa akun, boleh menjalankan
# eksperimen. Itu kebijakan platform ini dan tidak berubah.
#
# Setel "true" HANYA bila pemasangannya dapat dijangkau di luar jaringan
# tepercaya: satu run memakai worker berpagu 3,5 GB dengan concurrency 1,
# sehingga beberapa pengunjung sudah cukup memenuhi antreannya.
# REQUIRE_LOGIN_TO_RUN=false

# --- Admin pertama ---
# ⚠️ docker-compose.yml memuat bawaan `LAB_UBI_UNHAS` / `sampingkulkas09` yang TERTULIS di repo.
# Tanpa berkas .env, akun itulah yang dibuat. Timpa di sini untuk pemasangan
# yang dapat dijangkau orang lain. Minimal 8 karakter.
#
# Seed tidak pernah menimpa akun yang sudah ada: bila `LAB_UBI_UNHAS` sudah terlanjur
# dibuat, ganti sandinya lewat aplikasi, bukan lewat berkas ini.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Pembatas beban ---
# Bawaannya longgar: pada pemakaian lab tak seorang pun akan menyentuhnya.
# Nilai 0 mematikan pembatasnya.
#
# Berapa run MILIK SATU ORANG yang boleh mengantre/berjalan sekaligus.
# Dengan CELERY_CONCURRENCY=1 worker mengerjakan satu per satu, jadi run kelima
# seseorang hanya mengantre di belakang run keempatnya sendiri. Bila
# concurrency dinaikkan, kuota ini yang menentukan berapa banyak milik SATU
# orang boleh mengisi slot yang tersedia.
# MAX_ACTIVE_RUNS_PER_OWNER=3
#
# Berapa run boleh DIMULAI dalam satu jendela waktu. Kuota saja tidak cukup:
# yang membatalkan lalu memulai lagi berulang tetap menguasai antrean.
# MAX_RUNS_PER_WINDOW=20
# RUN_WINDOW_MINUTES=10
